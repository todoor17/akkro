# Image for extrage_pst.py: reading the Outlook PST and the text of the attachments.
# Debian's python3-pypff has no recipient table, so libpff-python is built from PyPI.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev build-essential zlib1g-dev \
        python3-bs4 python3-lxml python3-openpyxl python3-docx poppler-utils catdoc \
    && pip install --break-system-packages --no-cache-dir libpff-python==20260926 \
    && apt-get purge -y build-essential python3-dev && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
